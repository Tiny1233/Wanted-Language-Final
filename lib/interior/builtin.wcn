# Wanted built-in file

# Constants
true = 1
false = 0

func set_wdbg(on_or_off):
    if on_or_off:
        getwcore 'wdbg' true
    else:
        getwcore 'wdbg' false

func not(condition):
    if condition:
        return false
    
    return true



func out(cont):
    getwcore 'stdout' cont

func outs(cont, sep):
    if sep:
        out(cont + sep)
    else:
        out(cont + '\n')

func outln(cont):
    getwcore 'stdout' cont + '\n'

set_wdbg(false)



