# Wanted built-in file

# Constants
true = 1
false = 0



func not(condition):
    if condition:
        return false
    
    return true



func out(cont):
    getwcore 'stdout' cont

func outs(cont, sep):
    if sep:
        out(cont + sep)
    else:
        out(cont + '\n')

func outln(cont):
    getwcore 'stdout' cont + '\n'



