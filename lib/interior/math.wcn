# Wanted mathematics library.
# *?* %built 26/08/12

# Constants
abstract PI = 3.14159265358979323846264338327950288419716939937510
abstract E =  2.71828182845904523536028747135266249775724709369996

# float to int
func float_to_int(origin):
    return ((0 + origin) // 1)

func floor(origin):
    base_i = float_to_int(origin)
    if origin > base_i:
        return base_i
    else:
        return base_i - 1

func ceil(origin):
    return floor(0 + origin) + 1

func ceiling(origin):
    return ceil(0 + origin)

func round(origin):
    return floor((0 + origin) + 1 / 2)

func abs(val):
    cval = 0 + val
    if cval > 0:
        return cval
    else:
        return -cval

func mod(a, b):
    if b == 0:
        # TODO: ERROR
        return
    # a % b
    dres = floor(a / b)
    r = a - dres * b
    # prevent precision error
    if r < 0:
        if abs(r) > b:
            r += b
    return r

# Interval calcs
func nmap(val, left, right, to_left, to_right):
    # (b-a)/(x-a)*(d-c)+c
    return ((val - left) / (right - left) * (to_right - to_left) + to_left)


