# this minigame is played by my classmates and its rules may differ from others.
ext @builtin.wcn
ext @rng.wcn 
ext @string.wcn



func input_4digit():
    rep inf:
        ip = input('请输入四位不重复密码: ')

        if (len(ip) == 4) & (is_set(ip)):
            return ip

func calc_ab(ans, att):
    starting = {'❌', '🔴', '🟠', '🟠', '🟡', '🟡', '🟢', '🟢', '🟢'}
    idd = -1
    aa = 0
    bb = 0
    rep 4:
        idd += 1
        if contains(ans, att[idd]):
            aa += 1
        if att[idd] == ans[idd]:
            bb += 1
    
    outln(cif(((aa == 4) & (bb == 4)), '⭐ GGWP! 答案就是: ' + str(ans), starting[aa + bb] + ' ' + str(att) + ': ' + str(aa) + 'A' + str(bb) + 'B'))
    return ((aa == 4) & (bb == 4))

    


func run_2a1b():
    
    # generate base list
    list = {1, 2, 3, 4, 5, 6, 7, 8, 9, 0}
    shuffle(list)


    pwd = str(list[0]) + str(list[1]) + str(list[2]) + str(list[3])
    round = 0

    rep 10:
        round += 1
        out('👉 第 ' + round + ' 轮: ')
        cguess = input_4digit()
        if calc_ab(pwd, cguess):
            break

    final:
        outln('👎 逊! 正确答案是: ' + str(pwd))


    
