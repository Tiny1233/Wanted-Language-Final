# Wanted built-in file for implements

# Constants BooleanType aka wcf.NumberType
abstract true = 1
abstract false = 0
abstract nothing = ...

# Program settings
_wcore_wdbg_status = false
_wcore_rt_on = false

abstract func set_wdbg(on_or_off):
    # @brief Set whether the Wanted debugger is on or off
    # @param on_or_off: literally
    if on_or_off:
        _wcore_wdbg_status = true
    else:
        _wcore_wdbg_status = false
    _wcore_wdbg(_wcore_wdbg_status)


abstract func set_rt(on_or_off):
    # @brief Set whether the Wanted runtime recorder is on or off.
    # @param on_or_off: literally
    if on_or_off:
        _wcore_rt_on = true
    else:
        _wcore_rt_on = false
    _wcore_rt(_wcore_rt_on)

abstract func not(condition: BooleanType) -> BooleanType: 
    # @brief Returns false if the condition is true, else false.
    # @param condition: (wcf.NumberType) The condition to be operated.
    # @return wcf.NumberType(BooleanType): The opposite boolean.
    ...

abstract func _wcore_stdout(subcontent):
    # @brief Using getwcore stdout.
    
    # @param subcontent: (any) The param of stdout.
    ...

abstract func _wcore_wdbg(subcontent):
    # @brief Using getwcore wdbg.
    
    # @param subcontent: (any) The param of wdbg setmode.
    ...

abstract func _wcore_rt(subcontent):
    # @brief Using getwcore rt.
    
    # @param subcontent: (any) The param of wdbg setmode.
    ...

abstract func out(cont: StringType) -> StringType:
    # @brief Outputs without seperating with endline or whitespace.
    
    # @param cont: (wcf.StringType) Something to be output.
    # @return wcf.StringType: aka. cont.
    ...

abstract func outs(cont: StringType, sep: StringType) -> StringType:
    # @brief Outputs content seperated with customize seperator.
    # @param cont: (wcf.StringType) Something to be output.
    # @param sep: (wcf.StringType) The seperator added after cont printed.
    # @return wcf.StringType: Just returns cont.
    ...

abstract func outln(cont: StringType) -> StringType:
    # @brief Outputs content seperated with a new line.
    # @param cont: (wcf.StringType) Something to be output.
    # @return wcf.StringType: aka. cont.
    ...

abstract func input(prompt):
    # @brief Provide the user with stdin terminal input.
    # @param prompt: (wcf.StringType) What shows before you input to prompt what you should enter here.
    # @return wcf.StringType: The content which the user inputs.
    res = (getwcore 'stdin' prompt)
    return res


# Type converts 
abstract func num(sth: any) -> NumberType:
    # @brief Convert sth into NumberType.
    # @param sth: Something to be converted.
    # @return wcf.NumberType: Converted number value.
    ...

abstract func int(sth: any) -> NumberType:
    # @brief Convert sth into an integer. See more in math.wcn.(Warning: String converts will lose precision)
    # @param sth: Something to be converted.
    # @return wcf.NumberType: The integer part of the decimal or converted string.
    ...

# Type identify
abstract func is_nothing(what):
    # @brief Judge whether the value is wcf.NothingType
    # @param what: The value to be judged.
    # @return wcf.NumberType: Result.
    return (what == nothing)

abstract func is_stringType(what):
    # @brief Judge whether the value is wcf.StringType
    # @param what: The value to be judged.
    # @return wcf.NumberType: Result.
    return (what == ('' + what))

abstract func is_numberType(what):
    # @brief Judge whether the value is wcf.NumberType
    # @param what: The value to be judged.
    # @return wcf.NumberType: Result.
    return (what == (0 + what))

abstract func is_listType(what):
    # @brief Judge whether the value is wcf.ListType
    # @param what: The value to be judged.
    # @return wcf.NumberType: Result.
    ...

abstract func is_set(what):
    # @brief Judge whether all value is unique.
    # @param what: The list/string to be judged.
    # @return wcf.NumberType: Result.
    ...

# Other:
abstract func cif(cond: BooleanType, res_if_true: any, res_if_false: any) -> any:
    # @brief Conditional operator packed in function.
    # @param cond: The condition.
    # @param res_if_true: What to be returned if cond is true.
    # @param res_if_false: Literally.
    # @return any: Either res_if_true or res_if_false
    if cond:
        return res_if_true
    else:
        return res_if_false

abstract func len(sth: any):
    # @brief Returns the length of sth. For number, it returns the digits of the integer part in decimal.
    # @param sth: The string, list, or number.
    # @return wcf.NumberType: The length.
    ...

abstract func find_first_elem(target: any, in_which: any{}):
    # @brief Returns the index which target first appears. Target is a character in string or an element in lists.
    # @param target: Something to be searched. It is a character in string, or an element in lists.
    # @param in_which: The base which is considered to contain the target.
    # @return wcf.NumberType: The index if found, else -1.
    length = len(in_which)
    ind = -1
    rep length:
        ind += 1
        if target == in_which[ind]:
            return ind
    
    return -1

# List operates  
abstract func contains(base: any{}, target: any):
    # @brief Returns if target is in base.
    # @param target: Something to be searched. It is a character in string, or an element in lists.
    # @param base: The base which is considered to contain the target.
    # @return wcf.NumberType: Whether it is found.
    ...

abstract func add_item(@li: any{}, elem: any):
    # @brief Add item to a list.
    # @param li(Alias): The list.
    # @param elem: Something to be added to the list.
    # @return 0
    ...

abstract func add_item_after(@li: any{}, index: NumberType, elem: any):
    # @brief Add item to a list after a defined index.
    # @param li(Alias): The list.
    # @param index: The element will be added after the element from it.
    # @param elem: Something to be added to the list.
    # @return 0
    ...

abstract func delete_last_item(@li: any{}):
    # @brief Delete the last element of a list.
    # @param li(Alias): The list.
    # @return 0
    ...

abstract func delete_item_by_index(@li: any{}, indexs: NumberType | NumberType{}):
    # @brief Delete all items in the list by index.
    # @param li(Alias): The list.
    # @param indexs: The indexs to be deleted, which can be either NumberType or ListType[NumberType].
    # @return 0
    ...

abstract func reset(@sth: any):
    # @brief Reset the variable to its default value.
    # @param sth(Alias): Something to be reset.
    # @return 0
    ...

abstract func reverse(@sth: any[]):
    # @brief Reverse a list or string.
    # @param sth(Alias): Something to be reversed.
    # @return 0
    ...

abstract func assertion(cond: BooleanType, re : any = 0):
    # @brief Make an assertion for a condition.
    # @param cond: True or false
    # @param re: Print first if it's assigned to a value.
    # @return 0
    ...

# It turns off debugger automatically, and you can turn on by calling the function.
set_wdbg(_wcore_wdbg_status)
set_rt(_wcore_rt_on)
