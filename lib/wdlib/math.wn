# Constants
abstract PI = 3.14159265358979323846264338327950288419716939937510
abstract E =  2.71828182845904523536028747135266249775724709369996

# float to int part

abstract func float_to_int(origin: NumberType) -> NumberType:
    # @brief Keep the integer part of a number.
    # @param origin: (wcf.NumberType) A float number.
    # @return wcf.NumberType: The processed integer.
    ...

abstract func floor(origin: NumberType) -> NumberType:
    # @brief Returns the floor value of a number.
    # @param origin: (wcf.NumberType) A float number.
    # @return wcf.NumberType: The processed integer.
    ...

abstract func ceil(origin: NumberType) -> NumberType:
    # @brief Returns the ceiling value of a number.
    # @param origin: (wcf.NumberType) A float number.
    # @return wcf.NumberType: The processed integer.
    ...

abstract func ceiling(origin: NumberType) -> NumberType:
    # @brief Returns the ceiling value of a number, aka. math.ceil().
    # @param origin: (wcf.NumberType) A float number.
    # @return wcf.NumberType: The processed integer.
    ...

abstract func round(origin: NumberType) -> NumberType:
    # @brief Returns the round value of a number, the integer part will be added 1 if the decimal part is not less than 0.5.
    # @param origin: (wcf.NumberType) A float number.
    # @return wcf.NumberType: The processed integer (round value).
    ...

abstract func stored abs(val: NumberType) -> NumberType:
    # @brief Returns the absolute value of a number.
    # @param val: (wcf.NumberType) A number.
    # @return wcf.NumberType: The absolute value.
    ...
    
abstract func mod(a: NumberType, b: NumberType) -> NumberType:
    # @brief Compute the modulo (remainder) of a divided by b.
    # @param a: (wcf.NumberType) Dividend value.
    # @param b: (wcf.NumberType) Modulus divisor, must not be zero.
    # @return wcf.NumberType: Remainder after division.
    ...

# Interval calcs
abstract func nmap(val, left, right, to_left, to_right):
    # @brief Map a value from an interval to another.
    # @param val: (wcf.NumberType) The number.
    # @param left: (wcf.NumberType) The left side of the origin interval.
    # @param right: (wcf.NumberType) The right side of the origin interval.
    # @param to_left: (wcf.NumberType) The left side of the new interval.
    # @param to_right: (wcf.NumberType) The right side of the new interval.
    # @return wcf.NumberType: The result
    return (((val - left) / (right - left)) * (to_right - to_left) + to_left)

abstract func stored fac(n: PositiveIntType) -> PositiveIntType:
    # @brief Returns the factorial of number n.
    # @param n: (wcf.PositiveIntType) The number.
    # @return The value.
    ...

abstract func get_dist(x: NumberType = 0, y: NumberType = 0):
    # @brief Returns the distance from (0, 0) to (x, y)
    # @param x: X coordiate.
    # @param y: Y coordiate.
    # @return The distance.
    return (x ^ 2 + y ^ 2) ^ 0.5

type Vec2:
    func _setup(x: NumberType = 0, y: NumberType = 0):
        ...

    func get_length():
        return get_dist(my.x, my.y)

    func _add(other: Vec2):
        return Vec2(my.x + other.x, my.y + other.y)

    func _sub(other: Vec2):
        return Vec2(my.x - other.x, my.y - other.y)

    func _mul(other: Vec2):
        if other is Vec2:
            return my.x * other.x + my.y * other.y
        eif other is NumberType:
            return Vec2(my.x * other, my.y * other)

    func _convert(otherType):
        _normalized_45degrees = 0.5 ^ 0.5
        return Vec2(my.x, my.y) * _normalized_45degrees

    func _to_str():
        return (
            $'({my.x}, {my.y})'
        )
        




