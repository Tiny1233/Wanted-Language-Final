# Wanted random number generator library.
# *?* %built 26/08/20
ext @math.wcn

abstract func rand() -> NumberType:
    # @brief Returns a random decimal between 0 and 1.
    # @return wcf.NumberType: A decimal r between 0 and 1.
    ...

abstract func rnum(left: NumberType, right: NumberType) -> NumberType:
    # @brief Returns a random decimal between a defined interval.
    # @param left: The minimum (Included).
    # @param right: The maximum (Included)
    # @return wcf.NumberType: The random number.
    ...

abstract func rint(left: NumberType, right: NumberType) -> NumberType:
    # @brief Returns a random integer between a defined interval.
    # @param left: The minimum (Included).
    # @param right: The maximum (Included)
    # @return wcf.NumberType: The random number.
    ...

abstract func roll(probability: NumberType) -> BooleanType:
    # @brief Let the user to roll a prize under a given probability.
    # @param probability: The rate of success.
    # @return wcf.NumberType: true if succeed, or false.
    ...

abstract func shuffle(@li: any[]):
    # @brief Shuffle an existing list, without new lists produced.
    # @param li(Alias): The list
    # @return nothing
    ...